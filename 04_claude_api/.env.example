# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your key is NOT scoped to a single workspace. Org-scoped keys
# must name a workspace per request, or the API returns:
#   "This API key is not scoped to a workspace..."
# Find the ID in the Console URL for the workspace. Leave unset otherwise.
ANTHROPIC_WORKSPACE_ID=
