# Claude. Omit the key to run without the cloud: first-agent and Knowledge chats then
# answer with a local model, and the Claude-only agents use the offline FakeProvider.
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=        # only for identity-linked keys

# Local models under Ollama (Day 27). All optional.
# OLLAMA_URL=http://localhost:11434
# LOCAL_MODELS=gemma4:12b,qwen3.5:9b   # default: the installed gemma4:* tags and qwen3.5:9b
# LOCAL_DEFAULT_MODEL=qwen3.5:9b       # the model new chats start on; setting it makes local the default even with a key
# LOCAL_NUM_CTX=8192                   # context window, sent on every call
# LOCAL_NUM_PREDICT=1024               # ceiling on generated tokens per call
# LOCAL_TIMEOUT_MS=180000              # per call, model load included
# LOCAL_LLM_DIR=../local_llm           # where the Day 26 Ollama client lives

# Local models in a Knowledge chat With RAG (Day 28). All optional.
# LOCAL_RAG_NUM_CTX=16384              # context window of every RAG call (router, answer, clarification); a prompt within 10% of it is flagged possible_truncation
# LOCAL_RAG_NUM_PREDICT=2048           # output ceiling of the RAG calls (submit_answer carries quotes)
# RAG_JUDGE_MODEL=claude-haiku-4-5-20251001   # eval:local's judges (cloud); generation is Claude Haiku 4.5 + each LOCAL_MODELS model
