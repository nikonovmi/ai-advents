{
  "name": "first-agent",
  "version": "1.0.0",
  "description": "A minimal chat app built around a reusable Agent class and a provider-neutral LLM abstraction.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test src/",
    "scenario": "node scripts/scenario.js",
    "compare": "node scripts/compare.js",
    "lifecycle": "node scripts/lifecycle.js",
    "mcp:tools": "node scripts/mcp-tools.js",
    "mcp:call": "node scripts/mcp-call.js",
    "eval:planner": "node scripts/eval-planner.js",
    "eval:rag": "node scripts/eval-rag.js",
    "eval:citations": "node scripts/eval-citations.js",
    "eval:chat": "node scripts/eval-chat.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ajv": "^8.20.0",
    "dompurify": "^3.4.16",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
